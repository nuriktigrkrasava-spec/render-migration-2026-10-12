# Скопируй в .env и заполни значения.
# В production эти переменные задаются через Render Dashboard → Environment.

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Разбор фото чек-листов моделью. ВКЛЮЧЁН по умолчанию с 26.08.2026.
# Выключить срочно: CHECKLIST_AI=0 (без деплоя, перезапуск сервиса).
# Тратит деньги: держится выборка CHECKLIST_SAMPLE_PCT (по умолчанию 20%)
# плюс спорные случаи. Требует ANTHROPIC_API_KEY.
CHECKLIST_AI=
# Хранить ли сами кадры на диске. По умолчанию НЕТ: их не отдаёт наружу ни
# одна ручка, разбор берёт кадры из памяти запроса, а на /data они копили
# гигабайты бессрочно. Включать, только если появится просмотр фото.
CHECKLIST_KEEP_PHOTOS=
# С какого дня чек-листы идут в зачёт на «Горе» (YYYY-MM-DD).
# Пусто — не идут вовсе: ни баллов, ни штрафов. Это режим тестирования.
# Ожидание считается от этой даты для ВСЕХ филиалов одинаково, сдавал
# филиал хоть раз или нет. Ставить в день реальной раскатки, не задним числом.
CHECKLIST_FROM=

# Логин для демо-режима (любой ID, под которым показываем фейковые данные)
DEMO_API_LOGIN=demo

# Путь к SQLite БД. На Render укажи /data/iiko_boss.db (persistent disk mount)
DB_PATH=iiko_boss.db

# Ключ шифрования паролей iiko в БД (Fernet, 32-байтный base64)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: при потере ключа невозможно расшифровать сохранённые пароли
ENCRYPTION_KEY=

# production — отключает Swagger /docs, включает HSTS, ограничивает CORS
ENVIRONMENT=production

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
# Случайная строка. Передай тот же secret_token при setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Фудкост в наблюдениях «Что изменилось». ВЫКЛЮЧЕН: у самохостед-iikoWeb он
# считается из техкарт x цен по всему меню — самый тяжёлый показатель сбора, а
# в оценку филиала на «Горе» не входит вовсе. Вернуть: ASSISTANT_FOODCOST=1
ASSISTANT_FOODCOST=
# Потолок одновременных запросов к iiko при сборе показателей (по умолчанию 12)
ASSISTANT_MAX_CALLS=
